# Rediscover system libraries on the current machine. Only the target names
# are recorded in ptolib's export; discovery paths never enter the package.
function(ptolib_find_system_codec name needs_encoder)
    set(_target "ptolib::codec_${name}")
    if(TARGET ${_target})
        get_target_property(_had_encoder ${_target} PTOLIB_HAS_ENCODER)
        if(_had_encoder)
            set(needs_encoder ON)
        endif()
    endif()
    if(name STREQUAL "zstd")
        find_path(PTOLIB_ZSTD_INCLUDE_DIR zstd.h)
        find_library(PTOLIB_ZSTD_LIBRARY NAMES zstd)
        set(_inc "${PTOLIB_ZSTD_INCLUDE_DIR}")
        set(_libs "${PTOLIB_ZSTD_LIBRARY}")
    elseif(name STREQUAL "lz4")
        find_path(PTOLIB_LZ4_INCLUDE_DIR lz4frame.h)
        find_library(PTOLIB_LZ4_LIBRARY NAMES lz4)
        set(_inc "${PTOLIB_LZ4_INCLUDE_DIR}")
        set(_libs "${PTOLIB_LZ4_LIBRARY}")
    elseif(name STREQUAL "brotli")
        find_path(PTOLIB_BROTLI_INCLUDE_DIR brotli/decode.h)
        find_library(PTOLIB_BROTLI_DEC_LIBRARY NAMES brotlidec)
        find_library(PTOLIB_BROTLI_COMMON_LIBRARY NAMES brotlicommon)
        set(_inc "${PTOLIB_BROTLI_INCLUDE_DIR}")
        set(_libs "${PTOLIB_BROTLI_DEC_LIBRARY}" "${PTOLIB_BROTLI_COMMON_LIBRARY}")
        if(needs_encoder)
            find_library(PTOLIB_BROTLI_ENC_LIBRARY NAMES brotlienc)
            list(PREPEND _libs "${PTOLIB_BROTLI_ENC_LIBRARY}")
        endif()
    elseif(name STREQUAL "deflate")
        find_path(PTOLIB_ZLIB_INCLUDE_DIR zlib.h)
        find_library(PTOLIB_ZLIB_LIBRARY NAMES z zlib zdll)
        set(_inc "${PTOLIB_ZLIB_INCLUDE_DIR}")
        set(_libs "${PTOLIB_ZLIB_LIBRARY}")
    else()
        message(FATAL_ERROR "Unknown ptolib system codec: ${name}")
    endif()
    if(NOT _inc OR NOT _libs OR _libs MATCHES "NOTFOUND")
        set(_ptolib_system_codec_found FALSE PARENT_SCOPE)
        return()
    endif()
    if(NOT TARGET ${_target})
        add_library(${_target} INTERFACE IMPORTED)
    endif()
    set_target_properties(${_target} PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_inc}"
        INTERFACE_LINK_LIBRARIES "${_libs}"
        PTOLIB_HAS_ENCODER "${needs_encoder}")
    set(_ptolib_system_codec_found TRUE PARENT_SCOPE)
endfunction()
