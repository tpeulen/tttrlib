@PACKAGE_INIT@
set(_ptolib_system_codecs "@_PTOLIB_SYSTEM_CODECS@")
set(_ptolib_system_encoder_codecs "@_PTOLIB_SYSTEM_ENCODER_CODECS@")
if(_ptolib_system_codecs)
    include("${CMAKE_CURRENT_LIST_DIR}/SystemCodecs.cmake")
    foreach(_ptolib_codec IN LISTS _ptolib_system_codecs)
        set(_ptolib_needs_encoder OFF)
        if(_ptolib_codec IN_LIST _ptolib_system_encoder_codecs)
            set(_ptolib_needs_encoder ON)
        endif()
        ptolib_find_system_codec("${_ptolib_codec}" "${_ptolib_needs_encoder}")
        if(NOT _ptolib_system_codec_found)
            set(ptolib_FOUND FALSE)
            set(ptolib_NOT_FOUND_MESSAGE "ptolib requires system ${_ptolib_codec} headers/libraries")
            return()
        endif()
    endforeach()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/ptolibTargets.cmake")
check_required_components(ptolib)
