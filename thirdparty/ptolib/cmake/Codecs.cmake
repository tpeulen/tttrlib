# SPDX-License-Identifier: MIT
# Bundled C implementations are private objects in the ptolib archive/shared library.
# Public codec headers and implementation definitions never propagate to consumers.
set(_PTOLIB_CODECS_ROOT "${CMAKE_CURRENT_LIST_DIR}/..")
include("${CMAKE_CURRENT_LIST_DIR}/SystemCodecs.cmake")

function(ptolib_configure_codecs target)
    set(_root "${_PTOLIB_CODECS_ROOT}")
    option(PTOLIB_DECODE_ONLY "Build codec decoding callbacks only" OFF)
    set(PTOLIB_DECODE_ONLY_CODECS "${PTOLIB_DECODE_ONLY_CODECS}" CACHE STRING
        "Codec names with decoding only: zstd;brotli;lz4;deflate")
    set(PTOLIB_NO_CODECS "${PTOLIB_NO_CODECS}" CACHE STRING
        "Legacy list of disabled codec names: zstd;brotli;lz4;deflate")
    set(_names zstd brotli lz4 deflate)
    foreach(_list PTOLIB_NO_CODECS PTOLIB_DECODE_ONLY_CODECS)
        foreach(_name IN LISTS ${_list})
            if(NOT _name IN_LIST _names)
                message(FATAL_ERROR "${_list}: unknown codec '${_name}' (expected zstd, brotli, lz4 or deflate)")
            endif()
        endforeach()
    endforeach()
    target_sources(${target} PRIVATE "${_root}/src/codecs/registry.cpp")
    set(_test_defs)
    set(_system_codecs)
    set(_system_encoder_codecs)
    foreach(_name IN LISTS _names)
        string(TOUPPER "${_name}" _upper)
        set(_provider_var "PTOLIB_${_upper}_PROVIDER")
        option(PTOLIB_WITH_${_upper} "Legacy: use system ${_name}" OFF)
        set(_default bundled)
        if(PTOLIB_WITH_${_upper})
            set(_default system)
        endif()
        if(_name IN_LIST PTOLIB_NO_CODECS)
            if(PTOLIB_WITH_${_upper})
                message(FATAL_ERROR "${_name}: PTOLIB_WITH_${_upper} conflicts with PTOLIB_NO_CODECS")
            endif()
            set(_default disabled)
        endif()
        set(${_provider_var} "${_default}" CACHE STRING "${_name} provider: bundled, system or disabled")
        set_property(CACHE ${_provider_var} PROPERTY STRINGS bundled system disabled)
        set(_provider "${${_provider_var}}")
        if(NOT _provider MATCHES "^(bundled|system|disabled)$")
            message(FATAL_ERROR "${_provider_var} must be bundled, system or disabled")
        endif()
        if(PTOLIB_WITH_${_upper} AND NOT _provider STREQUAL "system")
            message(FATAL_ERROR "PTOLIB_WITH_${_upper} conflicts with ${_provider_var}=${_provider}")
        endif()
        if(_name IN_LIST PTOLIB_NO_CODECS AND NOT _provider STREQUAL "disabled")
            message(FATAL_ERROR "PTOLIB_NO_CODECS conflicts with ${_provider_var}=${_provider}")
        endif()
        if(_provider STREQUAL "disabled")
            list(APPEND _test_defs PTOLIB_TEST_HAS_${_upper}=0 PTOLIB_TEST_CAN_ENCODE_${_upper}=0)
            message(STATUS "ptolib: ${_name} disabled")
            continue()
        endif()
        set(_decode_only OFF)
        if(PTOLIB_DECODE_ONLY OR _name IN_LIST PTOLIB_DECODE_ONLY_CODECS)
            set(_decode_only ON)
            target_compile_definitions(${target} PRIVATE PTOLIB_${_upper}_DECODE_ONLY=1)
            list(APPEND _test_defs PTOLIB_TEST_CAN_ENCODE_${_upper}=0)
        else()
            list(APPEND _test_defs PTOLIB_TEST_CAN_ENCODE_${_upper}=1)
        endif()
        list(APPEND _test_defs PTOLIB_TEST_HAS_${_upper}=1)
        target_compile_definitions(${target} PRIVATE PTOLIB_ENABLE_${_upper}=1)
        target_sources(${target} PRIVATE "${_root}/src/codecs/${_name}.cpp")
        if(_provider STREQUAL "system")
            set(_needs_encoder ON)
            if(_decode_only)
                set(_needs_encoder OFF)
            endif()
            ptolib_find_system_codec("${_name}" "${_needs_encoder}")
            if(NOT _ptolib_system_codec_found)
                message(FATAL_ERROR "${_provider_var}=system but ${_name} headers/libraries were not found")
            endif()
            list(APPEND _system_codecs "${_name}")
            if(_needs_encoder)
                list(APPEND _system_encoder_codecs "${_name}")
            endif()
            if(_name STREQUAL "deflate")
                target_compile_definitions(${target} PRIVATE PTOLIB_WITH_DEFLATE=1)
            endif()
            target_link_libraries(${target} PRIVATE "ptolib::codec_${_name}")
        else()
            set(_obj "${target}_bundled_${_name}")
            set(_dir "${_root}/thirdparty/${_name}")
            if(_name STREQUAL "zstd")
                add_library(${_obj} OBJECT "${_dir}/zstd.c")
                target_compile_definitions(${_obj} PRIVATE
                    ZSTDLIB_VISIBLE= ZSTDLIB_HIDDEN= ZSTDERRORLIB_VISIBLE=
                    ZSTDERRORLIB_HIDDEN= ZDICTLIB_VISIBLE= ZDICTLIB_HIDDEN=)
            elseif(_name STREQUAL "brotli")
                set(_sources)
                file(GLOB _inputs CONFIGURE_DEPENDS "${_dir}/common/*.inc" "${_dir}/dec/*.inc")
                if(NOT _decode_only)
                    file(GLOB _encoder_inputs CONFIGURE_DEPENDS "${_dir}/enc/*.inc")
                    list(APPEND _inputs ${_encoder_inputs})
                endif()
                # Vendored .inc files are upstream C translation units. Each gets
                # its own .c wrapper, preserving file-local symbols and C semantics.
                foreach(_input IN LISTS _inputs)
                    file(RELATIVE_PATH _relative "${_dir}" "${_input}")
                    string(REPLACE ".inc" ".c" _relative "${_relative}")
                    set(_wrapper "${CMAKE_CURRENT_BINARY_DIR}/ptolib-codecs/brotli/${_relative}")
                    get_filename_component(_wrapper_dir "${_wrapper}" DIRECTORY)
                    file(MAKE_DIRECTORY "${_wrapper_dir}")
                    file(GENERATE OUTPUT "${_wrapper}" CONTENT "/* Generated C translation unit; upstream source is unchanged. */\n#include \"${_input}\"\n")
                    list(APPEND _sources "${_wrapper}")
                endforeach()
                add_library(${_obj} OBJECT ${_sources})
                set(_dir "${_dir}/include")
                if(NOT _decode_only)
                    list(APPEND _test_defs PTOLIB_EMBED_BROTLI=1)
                endif()
            elseif(_name STREQUAL "lz4")
                add_library(${_obj} OBJECT "${_dir}/lz4.c" "${_dir}/lz4hc.c"
                    "${_dir}/lz4frame.c" "${_dir}/xxhash.c")
                target_compile_definitions(${_obj} PRIVATE LZ4LIB_VISIBILITY= LZ4FLIB_VISIBILITY=
                    XXH_NAMESPACE=ptolib_lz4_)
            else()
                set(_dir "${_root}/thirdparty/miniz")
                add_library(${_obj} OBJECT "${_dir}/miniz.c")
                target_compile_definitions(${_obj} PRIVATE MINIZ_NO_ZLIB_COMPATIBLE_NAMES
                    MINIZ_NO_ARCHIVE_APIS MINIZ_NO_STDIO)
                target_compile_definitions(${target} PRIVATE MINIZ_NO_ZLIB_COMPATIBLE_NAMES
                    MINIZ_NO_ARCHIVE_APIS MINIZ_NO_STDIO)
                if(_decode_only)
                    target_compile_definitions(${_obj} PRIVATE MINIZ_NO_DEFLATE_APIS)
                    target_compile_definitions(${target} PRIVATE MINIZ_NO_DEFLATE_APIS)
                endif()
            endif()
            set_target_properties(${_obj} PROPERTIES POSITION_INDEPENDENT_CODE ON
                C_VISIBILITY_PRESET hidden C_STANDARD 99 C_STANDARD_REQUIRED ON)
            target_include_directories(${_obj} PRIVATE "${_dir}")
            target_include_directories(${target} PRIVATE "${_dir}")
            target_sources(${target} PRIVATE $<TARGET_OBJECTS:${_obj}>)
            if(_decode_only AND (_name STREQUAL "zstd" OR _name STREQUAL "lz4"))
                message(STATUS "ptolib: ${_name} decoding callbacks only; pinned C sources contain both directions")
            endif()
        endif()
        message(STATUS "ptolib: ${_name} ${_provider}, decode-only=${_decode_only}")
    endforeach()
    set(_ptolib_codec_defs "${_test_defs}" PARENT_SCOPE)
    set(_PTOLIB_SYSTEM_CODECS "${_system_codecs}" PARENT_SCOPE)
    set(_PTOLIB_SYSTEM_ENCODER_CODECS "${_system_encoder_codecs}" PARENT_SCOPE)
endfunction()
